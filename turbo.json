{
  "$schema": "https://turbo.build/schema.json",
  // Repo-root files that packages read at runtime. Four test suites already load fixtures/ via
  // import.meta.url, and the site reads it at build time; without this, editing a fixture produces
  // a cache hit on a stale result.
  "globalDependencies": ["fixtures/**", "docs/**", "eval/*.md"],
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "lib/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "lint:check": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "validate": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "lib/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
