.idea
*.iml
# Anchored to where ts-builds actually writes dev/prod output. Bare `lib` and `dist` match at any
# depth, which silently swallowed site/src/lib/ — the site built locally and failed in CI with
# "Cannot find module '../lib/view'".
packages/*/lib
packages/*/dist
site/dist
.turbo
.prosemeter

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage
*.lcov
.nyc_output

# Dependencies
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional caches
.npm
.eslintcache

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env
.env.*.local
.env.local

# Claude Code
.claude/settings.local.json
# eval scratch directories. The committed corpus is eval/corpus/ — see eval/corpus/README.md for
# why the answers are kept rather than discarded, and how they are marked. These are the unmarked
# working copies the migration read from.
eval/out
eval/out-run2
eval/out-run3
eval/out-run4
eval/out-sonnet
eval/out-run5
eval/out-run6

# Run 6's revision prompts embed the draft they revise, so committing them would duplicate
# eval/corpus/run-5 sixty times. They are regenerated byte-identically by `revise-prompts.mjs`
# from the corpus and the engine version. The part that must be committed — which dimensions each
# draft was marked on, recorded before any revision existed — is targets.json, which is not a .txt.
eval/prompts/**/*.txt

# Astro / Cloudflare (site/) — `dist` above is unanchored and already covers site/dist
.astro/
.wrangler/
