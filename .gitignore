.idea
*.iml
# Anchored to where ts-builds actually writes dev/prod output. Bare `lib` and `dist` match at any
# depth, which silently swallowed site/src/lib/ — the site built locally and failed in CI with
# "Cannot find module '../lib/view'".
packages/*/lib
packages/*/dist
site/dist
.turbo
.prosemeter

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage
*.lcov
.nyc_output

# Dependencies
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional caches
.npm
.eslintcache

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env
.env.*.local
.env.local

# Claude Code
.claude/settings.local.json
# eval run artifacts — generated answers, not fixtures (see eval/README.md)
eval/out
eval/out-run2
eval/out-run3
eval/out-run4
eval/out-sonnet
eval/out-run5

# Astro / Cloudflare (site/) — `dist` above is unanchored and already covers site/dist
.astro/
.wrangler/
