---
/**
 * One study. The report's own markdown, with the run's measured table rendered above it.
 *
 * The table is computed from `eval/results/*.json` rather than lifted out of the prose, so the
 * figures on the page cannot drift from the data the repository holds. The report body is rendered
 * from `eval/` in place — the site does not keep a second copy.
 */
import type { GetStaticPaths } from "astro"
import { getCollection, render } from "astro:content"

import Base from "../../layouts/Base.astro"
import { compositeSpread, run, variantRows } from "../../lib/research"

export const getStaticPaths = (async () => {
  const studies = await getCollection("research")
  return studies.map((study) => ({ params: { slug: study.data.slug }, props: { study } }))
}) satisfies GetStaticPaths

const { study } = Astro.props
const { Content } = await render(study)

const data = run(study.data.run)
const rows = data === undefined ? [] : variantRows(data)
const n0 = (n: number) => Math.round(n)
const n1 = (n: number) => n.toFixed(1)
---

<Base title={`${study.data.title} — prosemeter research`} description={study.data.finding}>
  <div class="band">
    <p class="crumb"><a href="/research">← Research</a></p>
    <h1>{study.data.title}</h1>
    <p class="standfirst">{study.data.finding}</p>
    <p class="meta">
      run {study.data.run} · {study.data.date}{data?.model === undefined ? "" : ` · ${data.model}`}
    </p>
  </div>

  {
    data !== undefined && (
      <div class="band tint">
        <h2>The measured result</h2>
        <p>
          {data.n} answers, {data.variants.length} instruction{data.variants.length === 1 ? "" : "s"}, {data.tasks.length}{" "}
          tasks. Scored against the <code>chat</code> profile by prosemeter {data.prosemeterVersion}.
        </p>
        <div class="scroll">
          <table class="dims">
            <thead>
              <tr>
                <th scope="col">arm</th>
                <th scope="col">n</th>
                <th scope="col">words</th>
                <th scope="col">jargon %</th>
                <th scope="col">sentence-simplicity</th>
                <th scope="col">grade band</th>
                <th scope="col">clarity</th>
                <th scope="col">composite (spread)</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((v) => {
                const [lo, hi] = compositeSpread(data, v.variant)
                return (
                  <tr>
                    <th scope="row">{v.variant}</th>
                    <td class="num">{v.n}</td>
                    <td class="num">{n0(v.words)}</td>
                    <td class="num">{n1(v.jargonPct)}</td>
                    <td class="num">{n1(v.sentenceSimplicity)}</td>
                    <td class="num">{n1(v.gradeBand)}</td>
                    <td class="num">{n1(v.clarity)}</td>
                    <td class="num">
                      {n1(v.composite)} <span class="dim">({n0(lo)}–{n0(hi)})</span>
                    </td>
                  </tr>
                )
              })}
            </tbody>
          </table>
        </div>
        <p class="note">
          <strong>Read the columns, not the composite.</strong> The bracketed range is the spread of composites{" "}
          <em>within</em> that one arm. Where it is wider than the gap between two arms — which is usually — the gap
          between them is not a result.
        </p>
      </div>
    )
  }

  <div class="band report">
    <Content />
  </div>

  <div class="band tint">
    <h2>The data behind this</h2>
    <ul>
      <li>
        <a
          href={`https://github.com/jordanburke/prosemeter/blob/main/eval/results/run-${study.data.run}.json`}
          >eval/results/run-{study.data.run}.json</a
        > — every dimension score for every answer
      </li>
      <li>
        <a href={`https://github.com/jordanburke/prosemeter/tree/main/eval/corpus/run-${study.data.run}`}
          >eval/corpus/run-{study.data.run}/</a
        > — the answers themselves, marked as experiment output
      </li>
      <li>
        <a href={`https://github.com/jordanburke/prosemeter/blob/main/eval/${study.id}`}>the full report</a> — this page
        renders it
      </li>
    </ul>
  </div>
</Base>

<style>
  .crumb {
    font: 0.9rem var(--mono);
    margin-bottom: 1rem;
  }
  .standfirst {
    font-size: 1.15rem;
  }
  .meta {
    font: 0.85rem var(--mono);
    color: var(--dim);
  }
  .scroll {
    overflow-x: auto;
  }
  .scroll table {
    min-width: 44rem;
  }
  .num {
    text-align: right;
    font: 0.9rem var(--mono);
  }
  .dim {
    color: var(--dim);
  }
  .note {
    font-size: 0.95rem;
  }
  /* The report is authored markdown, rendered from eval/. Its elements carry no classes, so
     anything site.css scopes to a class (`table.dims`) does not reach them. */

  /* The report opens with its own `# ` title, which made two h1s on one page — this one and the
     page header above it. The header already carries the title, run, date and finding, and the
     full report is linked at the foot, so the duplicate is removed rather than restyled. */
  .report :global(h1) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The report opens with its own `# ` title, which made two h1s on one page -- this one and the
     page header above it, which already carries the title, run, date and finding.

     `display: none`, not a visually-hidden clip-path: visually-hidden is *designed* to keep an
     element in the accessibility tree, so it left the duplicate in the document outline and only
     stopped sighted readers seeing it. This removes it from the tree. The full report, heading and
     all, is linked at the foot of the page and read directly on GitHub. */
  .report :global(h1) {
    display: none;
  }

  /* Markdown tables get no styling at all otherwise — site.css styles `table.dims`, and these have
     no class. Mirrors that rule set so a rendered report reads like the measured table above it.

     `width: max-content` with `min-width: 100%` fills the column when the table is narrow and
     scrolls inside itself when it is not, which plain `display: block` does not do — that collapses
     the table to its content width and pins it left. */
  .report :global(table) {
    display: block;
    overflow-x: auto;
    width: max-content;
    min-width: 100%;
    max-width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    /* margin-block, not the shorthand: a `0` in the inline slot resets `.band > *`'s auto centring. */
    margin-block: 1.5rem;
  }
  .report :global(th),
  .report :global(td) {
    text-align: left;
    font-weight: 400;
    padding: 0.35rem 1rem 0.35rem 0;
    vertical-align: top;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
  }
  .report :global(thead th) {
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--dim);
    white-space: nowrap;
  }
  /* Leading column is a label, the rest are figures. Keeps columns from wrapping mid-number. */
  .report :global(tbody td) {
    white-space: nowrap;
  }
  .report :global(tbody td:first-child) {
    white-space: normal;
  }
</style>
