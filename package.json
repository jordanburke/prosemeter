{
  "name": "prosemeter-monorepo",
  "private": true,
  "type": "module",
  "description": "Monorepo for prosemeter — a deterministic scoring + feedback-loop layer for prose",
  "author": "jordan.burke@gmail.com",
  "license": "MIT",
  "homepage": "https://prosemeter.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordanburke/prosemeter.git"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run validate",
    "dev": "turbo run dev",
    "site:dev": "turbo run dev --filter=prosemeter-site",
    "site:build": "turbo run build --filter=prosemeter-site",
    "clean": "pnpm -r clean && rm -rf .turbo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.10.9"
  }
}
