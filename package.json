{
  "name": "prosemeter-monorepo",
  "private": true,
  "type": "module",
  "description": "Monorepo for prosemeter \u2014 a deterministic scoring + feedback-loop layer for prose",
  "author": "jordan.burke@gmail.com",
  "license": "MIT",
  "homepage": "https://prosemeter.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordanburke/prosemeter.git"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run validate",
    "dev": "turbo run dev",
    "site:dev": "turbo run dev --filter=prosemeter-site",
    "site:build": "turbo run build --filter=prosemeter-site",
    "clean": "pnpm -r clean && rm -rf .turbo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "packageManager": "pnpm@11.27.0+sha512.ad12821463bb143295f1fa3ecde77a6b9b97a7990386da800ff57bffc3964dc64b7b1c7559d5dbe5c337aea659ed9c8937d4370bd198ca2009bc6fa0249808e7",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "turbo": "^2.10.12"
  }
}
