{
  "name": "prosemeter-monorepo",
  "private": true,
  "type": "module",
  "description": "Monorepo for prosemeter — a deterministic scoring + feedback-loop layer for prose",
  "author": "jordan.burke@gmail.com",
  "license": "MIT",
  "homepage": "https://prosemeter.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordanburke/prosemeter.git"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run validate",
    "dev": "turbo run dev",
    "site:dev": "turbo run dev --filter=prosemeter-site",
    "site:build": "turbo run build --filter=prosemeter-site",
    "clean": "pnpm -r clean && rm -rf .turbo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "turbo": "^2.10.12"
  }
}
